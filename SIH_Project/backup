                </div>
                """,
                unsafe_allow_html=True
            )

        st.write("")


    # ========================================================
    # FINAL RESULT
    # ========================================================

    st.divider()

    st.subheader("5️⃣ Preliminary Assessment")

    if score >= 90:

        st.markdown(
            """
            <div class="success-box">
            <h3>🟢 LOW RISK</h3>
            The scanned label contains the major declarations checked by this prototype.
            </div>
            """,
            unsafe_allow_html=True
        )

    elif score >= 70:

        st.markdown(
            """
            <div class="warning-box">
            <h3>🟡 MEDIUM RISK</h3>
            Some declarations require verification or appear to be missing.
            </div>
            """,
            unsafe_allow_html=True
        )

    else:

        st.markdown(
            """
            <div class="danger-box">
            <h3>🔴 HIGH RISK</h3>
            Multiple declarations were not detected. Manual verification is recommended.
            </div>
            """,
            unsafe_allow_html=True
        )


    # ========================================================
    # REPORT
    # ========================================================

    st.divider()

    st.subheader("6️⃣ Inspection Evidence Report")

    report_id = generate_report_id()

    report_time = datetime.now().strftime("%d-%m-%Y %H:%M:%S")

    report_lines = []

    report_lines.append("NIRIKSHAN")
    report_lines.append("Smart Packaged Commodity Compliance Screening System")
    report_lines.append("=" * 55)
    report_lines.append("")
    report_lines.append(f"Report ID: {report_id}")
    report_lines.append(f"Date & Time: {report_time}")
    report_lines.append(f"Mode: {mode}")
    report_lines.append("")
    report_lines.append("PRELIMINARY COMPLIANCE ASSESSMENT")
    report_lines.append("-" * 55)
    report_lines.append(f"Compliance Score: {score}%")
    report_lines.append(f"Risk Level: {risk}")
    report_lines.append("")
    report_lines.append("DETECTED DECLARATIONS")
    report_lines.append("-" * 55)

    for key, value in fields.items():

        report_lines.append(
            f"{key}: {value if value else 'Not detected'}"
        )

    report_lines.append("")
    report_lines.append("VALIDATION RESULTS")
    report_lines.append("-" * 55)

    for item in checks:

        status = "PASS" if item["Status"] else "FLAG"

        report_lines.append(
            f"{status} | {item['Requirement']} | "
            f"{item['Detected'] if item['Detected'] else 'Not detected'}"
        )

    report_lines.append("")
    report_lines.append(
        "DISCLAIMER: This report is a preliminary screening output "
        "for demonstration/prototype purposes. It is not a legal certificate "
        "or final enforcement determination."
    )

    report_text = "\n".join(report_lines)

    st.code(report_text)

    st.download_button(
        label="📄 Download Inspection Report",
        data=report_text,
        file_name=f"{report_id}.txt",
        mime="text/plain"
    )


