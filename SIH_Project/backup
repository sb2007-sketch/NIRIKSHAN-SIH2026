# ============================================================
# OCR / FIELD EXTRACTION
# ============================================================

def extract_fields(text):

    fields = {
        "Manufacturer / Packer": "",
        "Consumer Care": "",
        "Net Quantity": "",
        "Date": "",
        "MRP": "",
        "Unit Sale Price": "",
        "Country of Origin": ""
    }

    # ========================================================
    # CLEAN OCR TEXT
    # ========================================================

    lines = [
        re.sub(r"\s+", " ", line).strip()
        for line in text.splitlines()
        if line.strip()
    ]

    full_text = " ".join(lines)

        # ========================================================
    # MANUFACTURER / PACKER / MARKETED BY
    # ========================================================

    manufacturer_patterns = [
        r"manufactured\s*by",
        r"manufactured/marketed\s*by",
        r"mfg\.?\s*by",
        r"mfd\.?\s*by",
        r"marketed\s*by",
        r"packed\s*by",
        r"packer"
    ]

    company_patterns = [
        r"pvt\.?\s*ltd",
        r"private\s+limited",
        r"\bltd\.?",
        r"\blimited\b",
        r"\binc\.?",
        r"\bindustries\b",
        r"\bcompany\b",
        r"\bcorporation\b",
        r"\benterprises?\b"
    ]

    for i, line in enumerate(lines):

        for pattern in manufacturer_patterns:

            if re.search(pattern, line, re.I):

                # Combine the current line and the next
                # few OCR lines because packaging text
                # is often broken across lines.
                nearby_text = " ".join(
                    lines[i:i + 5]
                )

                # Remove the declaration label itself.
                nearby_text = re.sub(
                    pattern,
                    "",
                    nearby_text,
                    count=1,
                    flags=re.I
                )

                nearby_text = re.sub(
                    r"^[\s:\-]+",
                    "",
                    nearby_text
                )

                # Try to find a company-like portion.
                company_match = re.search(
                    r"([A-Za-z][A-Za-z0-9&.,'()\- ]{5,}"
                    r"(?:Pvt\.?\s*Ltd\.?|Private\s+Limited|"
                    r"Limited|Ltd\.?|Inc\.?|Industries|"
                    r"Corporation|Enterprises?))",
                    nearby_text,
                    re.I
                )

                if company_match:

                    candidate = company_match.group(1).strip()

                    # Remove obvious OCR junk from beginning.
                    candidate = re.sub(
                        r"^[^A-Za-z]+",
                        "",
                        candidate
                    )

                    if len(candidate) >= 8:
                        fields["Manufacturer / Packer"] = (
                            candidate
                        )

                break

        if fields["Manufacturer / Packer"]:
            break

    # ========================================================
    # BACKUP MANUFACTURER SEARCH
    # ========================================================

    if not fields["Manufacturer / Packer"]:

        for i, line in enumerate(lines):

            if any(
                re.search(
                    pattern,
                    line,
                    re.I
                )
                for pattern in company_patterns
            ):

                # Prefer lines close to "Marketed by",
                # "Manufactured by", etc.
                previous_text = " ".join(
                    lines[max(0, i - 3):i + 1]
                )

                if any(
                    re.search(
                        pattern,
                        previous_text,
                        re.I
                    )
                    for pattern in manufacturer_patterns
                ):

                    fields["Manufacturer / Packer"] = line.strip()
                    break
       # ========================================================
    # CONSUMER CARE / COMPLAINTS / HELPLINE
    # ========================================================

    consumer_patterns = [
        r"consumer\s*care",
        r"customer\s*care",
        r"consumer\s*complaints?",
        r"customer\s*complaints?",
        r"complaints?",
        r"helpline",
        r"toll\s*free",
        r"contact\s*us"
    ]

    consumer_section_found = False

    for i, line in enumerate(lines):

        if any(
            re.search(
                pattern,
                line,
                re.I
            )
            for pattern in consumer_patterns
        ):

            consumer_section_found = True

            # Search several nearby OCR lines because
            # phone numbers are frequently broken by OCR.
            search_text = " ".join(
                lines[i:i + 6]
            )

            # ------------------------------------------------
            # NORMAL 10-DIGIT INDIAN PHONE NUMBER
            # ------------------------------------------------

            phone = re.search(
                r"(?:\+91[\s\-]?)?[6-9]\d{9}",
                search_text
            )

            if phone:

                fields["Consumer Care"] = (
                    phone.group(0)
                )

            else:

                # ------------------------------------------------
                # PHONE NUMBER WITH OCR SPACES
                # ------------------------------------------------

                spaced_phone = re.search(
                    r"(?:\+91[\s\-]?)?"
                    r"[6-9](?:[\s\-]?\d){9}",
                    search_text
                )

                if spaced_phone:

                    cleaned_phone = re.sub(
                        r"\D",
                        "",
                        spaced_phone.group(0)
                    )

                    if len(cleaned_phone) == 10:

                        fields["Consumer Care"] = (
                            cleaned_phone
                        )

            break

    # --------------------------------------------------------
    # IMPORTANT:
    # If a complaints/contact section exists but the number
    # cannot be read, do NOT invent a phone number.
    # Keep the field empty so the UI can flag it for review.
    # --------------------------------------------------------

    if consumer_section_found:

        if not fields["Consumer Care"]:

            fields["Consumer Care"] = ""
    # ========================================================
    # NET QUANTITY / NET CONTENT
    # ========================================================

    quantity_pattern = (
        r"([0-9]+(?:\.[0-9]+)?\s*"
        r"(?:kg|kgs|g|gm|gms|mg|l|lt|ltr|"
        r"ml|pcs|pc|pieces|piece))"
    )

    for i, line in enumerate(lines):

        if re.search(
            r"net\s*(?:quantity|qty|content|cont)",
            line,
            re.I
        ):

            search_text = " ".join(
                lines[i:i + 3]
            )

            match = re.search(
                quantity_pattern,
                search_text,
                re.I
            )

            if match:
                fields["Net Quantity"] = (
                    match.group(1).strip()
                )

            break

    # Backup search for "250 ml", "500 g", etc.
    if not fields["Net Quantity"]:

        for line in lines:

            match = re.search(
                quantity_pattern,
                line,
                re.I
            )

            if match:

                fields["Net Quantity"] = (
                    match.group(1).strip()
                )
                break

    # ========================================================
    # MRP
    # ========================================================

    # First find every occurrence of MRP.
    mrp_positions = list(
        re.finditer(
            r"\bmrp\b|maximum\s*retail\s*price",
            full_text,
            re.I
        )
    )

    if mrp_positions:

        # The last MRP is often the clearest declaration.
        for mrp_match in reversed(mrp_positions):

            start = mrp_match.start()

            # Only inspect a short section after MRP.
            section = full_text[
                start:start + 120
            ]

            # Remove obvious batch/date areas if they occur.
            section = re.split(
                r"batch\s*(?:no\.?|number)|"
                r"mfg\.?\s*date|"
                r"exp\.?\s*date",
                section,
                flags=re.I
            )[0]

            # Look for a currency symbol followed by a number.
            currency_match = re.search(
                r"(?:₹|rs\.?|inr)\s*"
                r"([0-9]{1,5}(?:\.[0-9]+)?)",
                section,
                re.I
            )

            if currency_match:

                value = float(
                    currency_match.group(1)
                )

                if 1 <= value <= 50000:
                    fields["MRP"] = (
                        "₹" + currency_match.group(1)
                    )
                    break

            # OCR may convert ₹ into $, ', =, etc.
            # Look for the LAST reasonable number near MRP.
            numbers = re.findall(
                r"\b([0-9]{1,5}(?:\.[0-9]+)?)\b",
                section
            )

            if numbers:

                for number in reversed(numbers):

                    value = float(number)

                    if 1 <= value <= 5000:

                        fields["MRP"] = "₹" + number
                        break

            if fields["MRP"]:
                break

    # ========================================================
    # UNIT SALE PRICE
    # ========================================================

    unit_patterns = [
        r"unit\s*sale\s*price",
        r"unit\s*price",
        r"sale\s*price\s*per\s*unit",
        r"price\s*per\s*unit",
        r"₹\s*[0-9]+\s*/\s*(?:kg|g|l|ml|unit)"
    ]

    for i, line in enumerate(lines):

        if any(
            re.search(pattern, line, re.I)
            for pattern in unit_patterns
        ):

            search_text = " ".join(
                lines[i:i + 3]
            )

            match = re.search(
                r"(?:₹|rs\.?|inr)?\s*"
                r"([0-9]{1,6}(?:\.[0-9]+)?)"
                r"\s*(?:/|per)?\s*"
                r"(kg|g|l|ml|unit)?",
                search_text,
                re.I
            )

            if match:

                value = match.group(1)
                unit = match.group(2)

                if unit:
                    fields["Unit Sale Price"] = (
                        "₹" + value + "/" + unit
                    )
                else:
                    fields["Unit Sale Price"] = (
                        "₹" + value
                    )

            break

        # ========================================================
    # MANUFACTURING / PACKING DATE
    # ========================================================

    date_labels = [
        r"mfg\.?\s*date",
        r"mfd\.?\s*date",
        r"manufacturing\s*date",
        r"manufactured\s*date",
        r"mfg\.?",
        r"mfd\.?",
        r"pkg\.?\s*date",
        r"packing\s*date",
        r"packed\s*date"
    ]

    date_patterns = [
        # DD/MM/YYYY or DD-MM-YYYY
        r"\b\d{1,2}[\/\-]\d{1,2}[\/\-]\d{2,4}\b",

        # MM/YYYY or MM-YYYY
        r"\b\d{1,2}[\/\-]\d{2,4}\b",

        # YYYY/MM or YYYY-MM
        r"\b\d{4}[\/\-]\d{1,2}\b"
    ]

    for i, line in enumerate(lines):

        if any(
            re.search(
                pattern,
                line,
                re.I
            )
            for pattern in date_labels
        ):

            nearby_text = " ".join(
                lines[i:i + 4]
            )

            # Look for a normal date first.
            for date_pattern in date_patterns:

                match = re.search(
                    date_pattern,
                    nearby_text
                )

                if match:

                    fields["Date"] = (
                        match.group(0)
                    )
                    break

            # If OCR separated the date into pieces,
            # try patterns such as "4 04".
            if not fields["Date"]:

                separated_date = re.search(
                    r"\b([0-9]{1,2})\s+([0-9]{2,4})\b",
                    nearby_text
                )

                if separated_date:

                    month_or_day = separated_date.group(1)
                    year = separated_date.group(2)

                    if (
                        1 <= int(month_or_day) <= 12
                        and len(year) in (2, 4)
                    ):

                        fields["Date"] = (
                            month_or_day + "/" + year
                        )

            break

    # ========================================================
    # COUNTRY OF ORIGIN
    # ========================================================

    origin_patterns = [
        r"country\s*of\s*origin",
        r"made\s*in",
        r"origin"
    ]

    for i, line in enumerate(lines):

        match = re.search(
            r"(?:country\s*of\s*origin|made\s*in|origin)"
            r"\s*[:\-]?\s*(.*)",
            line,
            re.I
        )

        if match:

            value = match.group(1).strip()

            if value:
                fields["Country of Origin"] = value

            else:

                if i + 1 < len(lines):
                    fields["Country of Origin"] = (
                        lines[i + 1]
                    )

            break

    # ========================================================
    # BACKUP: INDIA
    # ========================================================

    if not fields["Country of Origin"]:

        for line in lines:

            if re.search(
                r"\bindia\b",
                line,
                re.I
            ):

                fields["Country of Origin"] = "India"
                break

    return fields
# ============================================================
# COMPLIANCE ENGINE
# ============================================================

def check_compliance(fields):

    checks = []

    checks.append({
        "Requirement": "Manufacturer / Packer details",
        "Detected": fields["Manufacturer / Packer"],
        "Status": bool(fields["Manufacturer / Packer"]),
        "Rule": "LMPC declaration requirement"
    })

    checks.append({
        "Requirement": "Consumer care details",
        "Detected": fields["Consumer Care"],
        "Status": bool(fields["Consumer Care"]),
        "Rule": "LMPC declaration requirement"
    })

    checks.append({
        "Requirement": "Net quantity",
        "Detected": fields["Net Quantity"],
        "Status": bool(fields["Net Quantity"]),
        "Rule": "LMPC quantity declaration requirement"
    })

    checks.append({
        "Requirement": "Date declaration",
        "Detected": fields["Date"],
        "Status": bool(fields["Date"]),
        "Rule": "LMPC date declaration requirement"
    })

    checks.append({
        "Requirement": "MRP",
        "Detected": fields["MRP"],
        "Status": bool(fields["MRP"]),
        "Rule": "MRP declaration requirement"
    })

    checks.append({
        "Requirement": "Unit Sale Price",
        "Detected": fields["Unit Sale Price"],
        "Status": bool(fields["Unit Sale Price"]),
        "Rule": "Applicable unit sale price requirement"
    })

    checks.append({
        "Requirement": "Country of Origin",
        "Detected": fields["Country of Origin"],
        "Status": bool(fields["Country of Origin"]),
        "Rule": "Country of origin declaration requirement"
    })

    return checks


# ============================================================
# SCORE
# ============================================================

def calculate_score(checks):

    total = len(checks)
    passed = sum(1 for item in checks if item["Status"])

    score = round((passed / total) * 100)

    if score >= 90:
        risk = "LOW"
    elif score >= 70:
        risk = "MEDIUM"
    else:
        risk = "HIGH"

    return score, risk


